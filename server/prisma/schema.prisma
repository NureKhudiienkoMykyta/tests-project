// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model University {
  id   Int    @id @default(autoincrement())
  name String

  users User[]
  tests Test[]
}

model User {
  id                 Int         @id @default(autoincrement())
  email              String      @unique
  password_hash      String
  first_name         String
  last_name          String
  is_activated       Boolean     @default(false)
  email_verify_token String?
  role               Role        @default(common_user)
  created_at         DateTime    @default(now())
  updated_at         DateTime    @updatedAt
  university_id      Int?
  university         University? @relation(fields: [university_id], references: [id], onDelete: SetNull)
  stripeCustomerId   String?     @unique

  refreshTokens RefreshToken[]
  created_tests Test[]
  test_attempts TestAttempt[]
  subscriptions Subscription[]
}

model RefreshToken {
  id            Int      @id @default(autoincrement())
  refresh_token String
  created_at    DateTime @default(now())
  user_id       Int
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Test {
  id                 Int             @id @default(autoincrement())
  author_id          Int
  author             User            @relation(fields: [author_id], references: [id])
  university_id      Int?
  university         University?     @relation(fields: [university_id], references: [id], onDelete: SetNull)
  category_id        Int
  category           Category        @relation(fields: [category_id], references: [id])
  title              String
  description        String
  is_published       Boolean         @default(false)
  access_mode        TestAccessType  @default(PUBLIC)
  show_results       ShowResultsType @default(FULL)
  time_limit_seccond Int?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  questions            Question[]
  allowed_test_domains AllowedTestDomain[]
  allowed_test_emails  AllowedTestEmail[]
  test_attempts        TestAttempt[]
}

model Category {
  id         Int      @id @default(autoincrement())
  created_at DateTime @default(now())
  name       String

  tests Test[]
}

model Question {
  id             Int          @id @default(autoincrement())
  test_id        Int
  test           Test         @relation(fields: [test_id], references: [id], onDelete: Cascade)
  type           QuestionType
  content        String
  points         Int
  correct_answer String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  answers         Answer[]
  attempt_answers AttemptAnswer[]
}

model Answer {
  id          Int      @id @default(autoincrement())
  content     String
  is_correct  Boolean  @default(false)
  question_id Int
  question    Question @relation(fields: [question_id], references: [id], onDelete: Cascade)
}

model AllowedTestDomain {
  id      Int    @id @default(autoincrement())
  test_id Int
  test    Test   @relation(fields: [test_id], references: [id], onDelete: Cascade)
  domain  String
}

model AllowedTestEmail {
  id      Int    @id @default(autoincrement())
  test_id Int
  test    Test   @relation(fields: [test_id], references: [id], onDelete: Cascade)
  email   String
}

model TestAttempt {
  id          Int           @id @default(autoincrement())
  test_id     Int?
  test        Test?         @relation(fields: [test_id], references: [id], onDelete: SetNull)
  user_id     Int
  user        User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  status      AttemptStatus @default(IN_PROGRESS)
  score       Int           @default(0)
  max_score   Int
  started_at  DateTime      @default(now())
  finished_at DateTime?
  expired_at  DateTime? // started_at + time_limit_seconds

  attempt_answers AttemptAnswer[]
}

model AttemptAnswer {
  id                Int         @id @default(autoincrement())
  attempt_id        Int
  attempt           TestAttempt @relation(fields: [attempt_id], references: [id], onDelete: Cascade)
  question_id       Int?
  question          Question?   @relation(fields: [question_id], references: [id], onDelete: SetNull)
  question_snapshot String
  answer_snapshot   String
  is_correct        Boolean     @default(false)
  was_cancelled     Boolean     @default(false)
  answered_at       DateTime    @default(now())
}

model Subscription {
  id      String @id @default(cuid())
  user_id Int
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  stripe_subscription_id String?   @unique
  current_period_end     DateTime? // Дата наступного списання / закінчення ліміту

  stripe_price_id      String // Це ID зі STRIPE
  price                Price              @relation(fields: [stripe_price_id], references: [stripe_price_id])
  status               StatusSubscription
  cancel_at_period_end Boolean            @default(false) // Чи натиснув юзер "скасувати" (до кінця місяця преміум працює)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id                Int     @id @default(autoincrement())
  stripe_product_id String  @unique // prod_xxx з Stripe Dashboard
  name              String
  description       String?
  active            Boolean @default(true)
  prices            Price[]
}

model Price {
  id              Int     @id @default(autoincrement())
  stripe_price_id String  @unique // price_xxx з Stripe Dashboard
  productId       Int
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  amount          Int // Ціна в копійках (наприклад, 15000 для 150.00 UAH)
  currency        String  @default("uah") // 'uah', 'usd'
  interval        String // 'month' або 'year'
  active          Boolean @default(true)

  subscriptions Subscription[]
}

enum Role {
  admin
  common_user
}

enum TestAccessType {
  PUBLIC
  DOMAIN
  EMAIL_LIST
}

enum ShowResultsType {
  FULL
  ONLY_SCORE
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_TEXT
  LONG_TEXT
  NUMBER
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

enum StatusSubscription {
  ACTIVE
  UNPAID
  CANCELED
  PAST_DUE
  INCOMPLETE
}
